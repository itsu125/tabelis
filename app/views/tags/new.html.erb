<%= turbo_frame_tag "new_tag_form" do %>
  <%= form_with model: @tag do |f| %>
    <%# タグ名 %>
    <div class="mb-4">
      <%= f.label :name, "タグ名（必須）", class: "block text-sm font-medium mb-1 text-t-text-mid" %>
      <%= f.text_field :name,
            class: "w-full p-3 rounded-lg border border-t-border bg-white focus:ring-t-primary focus:border-t-primary" %>
    </div>
    <%# カラー %>
    <div class="mb-4">
      <p class="block text-sm font-medium mb-1 text-t-text-mid">
        カラー（必須）
      </p>
      <div class="flex flex-wrap gap-2">
        <% Tag.color_options.each do |label, class_name| %>
          <label class="cursor-pointer">
            <%= f.radio_button :color_class, class_name, class: "hidden" %>
            <span class="tag-color-pill px-3 py-1 rounded-full bg-gray-200 text-gray-700 border-gray-300 text-xs border border-t-border" <%= class_name %>">
              <%= label %>
            </span>
          </label>
        <% end %>
      </div>
    </div>

    <%# ボタン %>
    <div class="mt-4 flex justify-end gap-2">
      <%= f.submit "登録する",
            class: "px-4 py-2 rounded-lg bg-t-primary text-white text-sm font-bold" %>
      <button type="button"
              data-close-new-tag-form="true"
              class="px-4 py-2 rounded-lg bg-gray-200 text-gray-700 border-gray-300 border border-t-border text-sm text-t-text-mid">
        キャンセル
      </button>
    </div>
  <% end %>
<% end %>