<div class="mb-4">
  <label class="block text-sm font-medium mb-1 text-t-text-mid">
    タグ（複数選択可）
  </label>
  <div id="tag-select" class="flex flex-wrap gap-2">
    <% tags.each do |tag| %>
      <% selected = shop.tags.include?(tag) %>
      <button
        type="button"
        data-tag-id="<%= tag.id %>"
        data-tag-color-class="<%= tag.color_class %>"
        class="tag-pill px-3 py-1 rounded-full text-xs border
               <%= selected ? tag.color_class : 'bg-gray-200 text-gray-700 border-gray-300' %>">
        <%= tag.name %>
      </button>
    <% end %>
  </div>

  <!-- 新しいタグ登録ボタン -->
  <div class="mt-2">
    <%= link_to "＋ 新しいタグを作成",
          new_tag_path,
          data: { turbo_frame: "new_tag_form" },
          class: "text-sm text-t-primary underline cursor-pointer" %>
  </div>

  <!-- Turbo Frame：モーダル領域 -->
  <turbo-frame id="new_tag_form"></turbo-frame>
  <!-- hidden inputs（複数選択用） -->
  <%= hidden_field_tag "shop[tag_ids][]", nil %>  <%# 空を送ることで未選択も許容 %>
  <% shop.tags.each do |tag| %>
    <%= hidden_field_tag "shop[tag_ids][]", tag.id %>
  <% end %>
</div>